Maximum no of meetings that can be scheduled with k rooms.

int maxMeetings(vector<pair<int, int>>& meetings, int k) {
    if (k == 0)
        return 0;
    sort(meetings.begin(), meetings.end());   // sort by start time
    priority_queue<int, vector<int>, greater<int>> pq;
    int ans = 0;
    for(int i=0;i<k;i++)
      pq.push(0);
    for (int i=0;i<meetings.size();i++) {
        int start = meetings[i][0], end = meetings[i][1];
        if(pq.top() <= start){
            pq.pop()
            pq.push(end);
            ans++;
        }
    }
    return ans;
}
